# ---------------------------------------------------------------------------
# Supabase — คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (.env.local ถูก gitignore)
# ค่าเหล่านี้หาได้จาก Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------------------

# URL ของ Supabase project
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# anon/public key (เปิดเผยฝั่ง client ได้ — RLS คือด่านป้องกัน)
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# service-role key ใช้เฉพาะสคริปต์ seed ฝั่ง local เท่านั้น ห้าม commit / ห้าม ship
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
