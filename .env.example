# ---------------------------------------------------------------------------
# ตอนนี้ระบบเก็บข้อมูลบน localStorage (ไม่ต้องตั้งค่า env ใดๆ ก็รันได้)
# ตัวแปรด้านล่างเตรียมไว้สำหรับตอนต่อ Supabase ทีหลัง — ยังไม่ถูกใช้งานในโค้ด
# ---------------------------------------------------------------------------

# URL ของ Supabase project (เช่น https://xxxx.supabase.co)
# VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# anon/public key ของ Supabase (เปิดเผยฝั่ง client ได้ — RLS คือด่านป้องกัน)
# VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# service-role key ใช้เฉพาะสคริปต์ seed ฝั่ง local เท่านั้น ห้าม commit / ห้าม ship
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
